# ==========================================
# Root .gitignore for Monorepo (Angular + .NET)
# ==========================================

# Angular / Node.js
**/node_modules/
**/dist/
**/.angular/cache/
**/tmp/
**/out-tsc/
**/bazel-out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/

# .NET / C# / Visual Studio
**/bin/
**/obj/
**/.vs/
*.user
*.userosscache
*.sln.docstates
*.suo
*.userprefs
*.lock.json
project.lock.json
project.assets.json
**/TestResults/
**/coverage/

# Legacy / Backup folders
v1_backup/
vanilla/

# IDEs & System files
.idea/
.DS_Store
Thumbs.db
.history/*
.settings/
*.sublime-workspace
.c9/

# VS Code settings
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json

# Secrets & Local Environment Configs
**/secrets.json
**/*.secrets.json
**/appsettings.Development.json
**/appsettings.Local.json
**/appsettings*.local.json
**/appsettings*.Development.json
*.env
*.env.local

